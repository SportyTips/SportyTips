"""Makes the pick "No goal scored by a substitute" work (SportyBet: "Goal Scored by a Substitution", answer No).

Load it AFTER ticket_extras.py, in the same block in app.py:

    try:
        import ticket_extras
        import ticket_sub_fix
    except Exception as exc:
        print(f"NOTE: ticket extras are off: {type(exc).__name__}: {exc}")

smart_ticket.py, upgrades.py and ticket_extras.py are NOT edited.

Why the pick never appeared (found by reading smart_ticket.py and upgrades.py):
  1. After the football study, smart_ticket.py replaces every pick's chance with football_data.adjusted_p().
     That function does not know this pick, so the chance became 0 and the pick was thrown away.
     Now the chance of this pick always stays the one worked out from SportyBet's prices.
  2. upgrades.py keeps only picks with a 66%+ chance. "No" at 1.50 is about 61%, so it was cut.
     For a substitute request the bar is lowered to SUB_SURE_P (default 58%) while that request runs.
  3. ticket_extras.py decides "this is a substitute request" with smart_ticket._parse_extras(), which the
     smart_ticket.py you uploaded does not have. So the request was never switched to "substitute only".
     This file switches it on by itself, without that function.
  4. Reading all those games takes time, so the time allowed for it is longer for this request.

What a substitute request does: it makes a ticket of ONLY this pick, answer NO only, no straight win
(1X2), and only sure picks (chance from SportyBet's two prices, margin removed). The safest games come first.

Ask in chat:
    substitute no 10 picks tomorrow
    goal scored by a substitution no 8 picks today
"""

import os
import re
import threading

import main as bot
import smart_ticket as st
import ticket_extras as te

try:
    import upgrades as up
except Exception:
    up = None

# A pick needs at least this chance. Higher = safer but fewer games. Lower it if the ticket cannot be filled.
SURE_P = float(os.getenv("SUB_SURE_P", "0.58"))
MIN_ODD = float(os.getenv("SUB_MIN_ODD", "1.15"))
MAX_ODD = float(os.getenv("SUB_MAX_ODD", "2.50"))
DEFAULT_PICKS = int(os.getenv("SUB_DEFAULT_PICKS", "10"))
DETAIL_TIME = int(os.getenv("SUB_DETAIL_SECONDS", "90"))

te.SUB_MIN_P = SURE_P
te.SUB_MIN_ODD = MIN_ODD
te.SUB_MAX_ODD = MAX_ODD

# "substitute", "substitution", "substitutes", "sub goal", "subs no"
SUB_RE = re.compile(r"\bsubstitut\w*|\bsub\s+goal\w*|\bsubs?\s+no\b", re.I)
te.SUB_RE = SUB_RE

_HAS_NUMBER = re.compile(
    r"\d+(?:\.\d+)?\s*(?:odds?|picks?|games?|matches|selections?|tips?|legs?|teams?)\b", re.I
)

_BAD_WORDS = ("corner", "card", "booking", "1st", "2nd", "half", "first", "second", "assist", "minute")
_SKIPS = {}


def _skip(why, name):
    """Print each reason only a few times so the server log stays short."""
    _SKIPS[why] = _SKIPS.get(why, 0) + 1
    if _SKIPS[why] <= 3:
        print(f"Substitute pick skipped ({why}): {name}")


def _answer(outcome):
    """'yes' or 'no', whatever the letter case or the field the label is in."""
    for key in ("desc", "name", "label", "shortName"):
        value = str(outcome.get(key) or "").strip().lower()
        if value in ("yes", "no"):
            return value
    try:
        value = str(st._label_of(outcome) or "").strip().lower()
        if value in ("yes", "no"):
            return value
    except Exception:
        pass
    return ""


# ------------------------------------------------------------
# the pick itself: only the answer NO, only when it is sure
# ------------------------------------------------------------
def substitute_candidates(event, markets):

    home = str(event.get("homeTeamName", "Home"))
    away = str(event.get("awayTeamName", "Away"))
    found = []

    for market in markets or []:

        name = f"{market.get('desc') or ''} {market.get('name') or ''}".lower().strip()

        if "substitut" not in name:
            continue

        if name not in te._SUB_SEEN and len(te._SUB_SEEN) < 12:
            te._SUB_SEEN.add(name)
            print(f"Substitute market seen: {market.get('id')}: {name}")

        if any(word in name for word in _BAD_WORDS):
            _skip("other kind of market", name)
            continue

        if not any(word in name for word in ("goal", "score", "scorer")):
            _skip("no goal in the name", name)
            continue

        yes_odd = no_odd = None
        no_outcome = None

        for outcome in market.get("outcomes", []):

            if outcome.get("isActive") is False:
                continue

            odd = st._f(outcome.get("odds"))

            if not odd or odd <= 1:
                continue

            answer = _answer(outcome)

            if answer == "yes":
                yes_odd = odd
            elif answer == "no":
                no_odd, no_outcome = odd, outcome

        if not (yes_odd and no_odd):
            _skip("Yes and No prices not both open", name)
            continue

        if not (MIN_ODD <= no_odd <= MAX_ODD):
            _skip(f"No odd {no_odd} outside {MIN_ODD}-{MAX_ODD}", name)
            continue

        # chance of No with the bookmaker's margin taken out (Yes 2.37 / No 1.50 -> about 61%)
        chance = (1 / no_odd) / ((1 / no_odd) + (1 / yes_odd))

        if chance < SURE_P:
            _skip(f"chance {round(chance * 100)}% is below {round(SURE_P * 100)}%", name)
            continue

        h, a = home.lower(), away.lower()
        has_home = "home" in name or (len(h) > 3 and h in name)
        has_away = "away" in name or (len(a) > 3 and a in name)

        team = ""
        if has_home and not has_away:
            team = home
        elif has_away and not has_home:
            team = away

        te._SUB_STATS["events"].add(event.get("eventId"))

        found.append({
            "kind": "sub_goal",
            "label": "No goal scored by a substitute" + (f" ({team})" if team else ""),
            "odd": no_odd,
            "p": chance,
            "market_p": chance,
            "key": (str(market.get("id")), market.get("specifier") or "", str(no_outcome.get("id"))),
            "extra": True,
        })

    found.sort(key=lambda c: -c["p"])

    return found[:2]


te.substitute_candidates = substitute_candidates


# ------------------------------------------------------------
# 1) football study must not overwrite this pick's chance
# ------------------------------------------------------------
try:
    import football_data as fd

    _prev_adjusted_p = fd.adjusted_p

    def adjusted_p(candidate, facts, *args, **kwargs):
        if candidate.get("kind") == "sub_goal":
            return candidate.get("market_p", candidate.get("p", 0.0))
        return _prev_adjusted_p(candidate, facts, *args, **kwargs)

    fd.adjusted_p = adjusted_p

except Exception as exc:
    print(f"Substitute fix: could not protect the chance from football_data: {exc}")


# ------------------------------------------------------------
# 2) let the pick through upgrades.py's price floor
# ------------------------------------------------------------
if up is not None:
    try:
        up.EXTRA_KINDS.add("sub_goal")
    except Exception as exc:
        print(f"Substitute fix: could not add the pick to EXTRA_KINDS: {exc}")


# ------------------------------------------------------------
# 3) more time to read the games' own pages for a substitute request
# ------------------------------------------------------------
if hasattr(st, "_detail_order"):

    _prev_detail_order = st._detail_order

    def _detail_order(events, *args, **kwargs):
        if getattr(te._SUB_FLAG, "only", False):
            st.DETAIL_SECONDS = max(int(getattr(st, "DETAIL_SECONDS", 40) or 40), DETAIL_TIME)
        return _prev_detail_order(events, *args, **kwargs)

    st._detail_order = _detail_order


# ------------------------------------------------------------
# 4) switch a substitute request on (needs nothing from smart_ticket's new helpers)
# ------------------------------------------------------------
_prev_flow = bot.prediction_ticket_flow


def prediction_ticket_flow(chat_id, text, *args, **kwargs):

    text = text or ""

    if not SUB_RE.search(text) or st.DAILY_RE.search(text.lower()):
        return _prev_flow(chat_id, text, *args, **kwargs)

    print(f"Substitute request: {text!r}")

    if not _HAS_NUMBER.search(text):
        text = f"{text} {DEFAULT_PICKS} picks"

    te._SUB_FLAG.only = True
    te._SUB_STATS["events"].clear()
    _SKIPS.clear()

    cap_before = st.KIND_CAP.get("sub_goal")
    st.KIND_CAP["sub_goal"] = 10.0  # this ticket is made of this pick only

    saved = {}

    if up is not None:
        for name in ("STRONG_MIN_P", "STRONG_MIN_P_TOP"):
            if hasattr(up, name):
                saved[name] = getattr(up, name)
                setattr(up, name, min(getattr(up, name), SURE_P))

    try:
        return _prev_flow(chat_id, text, *args, **kwargs)
    finally:
        for name, value in saved.items():
            setattr(up, name, value)

        te._SUB_FLAG.only = False

        if cap_before is None:
            st.KIND_CAP.pop("sub_goal", None)
        else:
            st.KIND_CAP["sub_goal"] = cap_before

        print(f"Substitute request done: market found on {len(te._SUB_STATS['events'])} games; skipped: {dict(_SKIPS)}")


bot.prediction_ticket_flow = prediction_ticket_flow

print(f"OK: ticket_sub_fix.py loaded (No-only substitute pick, sure picks from {round(SURE_P * 100)}%)")
